# Copy this file to .env and edit. LearnLink runs fully on your own machine: no API keys, no cloud.
# Ollama must be running (ollama serve) with the models below pulled.

# Model that writes answers. Must fit the GPU (RTX 4050 = 6 GB VRAM). Run `ollama list` to see yours.
MODEL=gemma3:4b
# Small model that turns text into vectors for the "semantic" half of hybrid retrieval. Run: ollama pull nomic-embed-text
EMBED_MODEL=nomic-embed-text

# Where Ollama is running (same machine by default).
OLLAMA_HOST=http://127.0.0.1:11434

# Web server. HOST=0.0.0.0 lets other devices on the campus Wi-Fi/LAN open it.
PORT=3000
HOST=0.0.0.0

# Tuning
NUM_CTX=4096          # context window; keep small on 6 GB VRAM
MAX_CONCURRENT=1      # answers generated at the same time (others wait in line)
NUM_PREDICT=300       # longest answer in tokens
KEEP_ALIVE=4h         # how long the model stays in GPU memory after the last question (-1 = always)
RATE_PER_MIN=30       # questions per minute per device
TEMPERATURE=0.5       # 0.2 = strict and stiff, 0.8 = loose and chatty
ALLOW_GENERAL=true    # false = never answer outside the course modules

# Database (Laragon MySQL defaults). Create the tables with: php database/setup.php
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=learnlink
DB_USER=root
DB_PASS=

# PHP side (Laragon Apache). The folder must be C:\laragon\www\learnlink so this URL works.
PHP_API=http://127.0.0.1/learnlink/api
NODE_URL=http://127.0.0.1:3000
REQUIRE_LOGIN=true
# RELOAD_KEY is added to .env automatically by setup.php

# Google Classroom sync (optional). Create an OAuth client (type "Web application") in Google Cloud Console,
# add the redirect URI below, then paste the ID and secret here. See README "Google Classroom sync".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the redirect URI in Google Cloud exactly. Google only allows http for localhost, so teachers connect
# their account once on the server PC. With an https domain for the server, put that address here instead.
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google
# Only accounts from this domain can connect.
GOOGLE_HD=bisu.edu.ph
# How often to check Classroom for new posts while the server has internet.
SYNC_MINUTES=30
# If PHP cannot verify Google's certificate (error "SSL certificate problem"), point this to a cacert.pem file.
GOOGLE_CA_BUNDLE=

# "Continue with Google" for students, faculty and admin (optional). It only asks for name and email, so make it a
# SEPARATE Google Cloud project that you can publish "In production" (no 100-user cap, no logout every 7 days).
# Left empty, the Classroom client above is used. See README "Real accounts".
GOOGLE_SIGNIN_CLIENT_ID=
GOOGLE_SIGNIN_CLIENT_SECRET=
# Students open LearnLink from other devices, so this must be an https address of the campus server
# (for example https://learnlink.bisu.edu.ph/oauth/signin). http only works on the server PC itself (localhost).
GOOGLE_SIGNIN_REDIRECT_URI=http://localhost:3000/oauth/signin
# true = only students on a linked Classroom class list can sign up. false = any @bisu.edu.ph student.
SIGNUP_ROSTER_ONLY=false

# Email the sign-up code to the student (optional, needs internet when they ask). Easiest: a Gmail account for LearnLink
# with 2-Step Verification on, then myaccount.google.com/apppasswords -> create one and paste it below.
# Without this (or with no internet), the code still shows for the teacher and the admin inside LearnLink.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=LearnLink
